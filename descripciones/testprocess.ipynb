      "metadata": {
        "id": "intro"
      },
      "source": [
        "# Procesador de Video y Audio en Google Colab\n",
        "\n",
        "Este notebook te permite:\n",
        "1. Subir un archivo de video desde tu equipo.\n",
        "2. Extraer el audio en formato WAV usando ffmpeg.\n",
        "3. Subir el video y el audio a Google Drive.\n",
        "4. Guardar la información en MongoDB.\n",
        "\n",
        "Ejecuta las celdas en orden y luego llama a `upload_and_process_video()`."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "install_deps"
      },
      "source": [
        "# Instalar dependencias necesarias\n",
        "!pip install -q google-api-python-client google-auth-httplib2 google-auth-oauthlib pymongo"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "setup_and_functions"
      },
      "source": [
        "import os\n",
        "import time\n",
        "import subprocess\n",
        "from google.oauth2.credentials import Credentials\n",
        "from googleapiclient.discovery import build\n",
        "from googleapiclient.http import MediaFileUpload\n",
        "from pymongo import MongoClient\n",
        "from google.colab import files\n",
        "import shutil\n",
        "\n",
        "# ==========================\n",
        "# Configuración de credenciales\n",
        "# ==========================\n",
        "CLIENT_ID = '448213662107-7fuh61iinmeg78df9epa6ve54qm7mn2o.apps.googleusercontent.com'\n",
        "CLIENT_SECRET = 'YOUR_GOOGLE_OAUTH_CLIENT_SECRET'\n",
        "REFRESH_TOKEN = 'YOUR_GOOGLE_OAUTH_REFRESH_TOKEN'\n",
        "\n",
        "# ==========================\n",
        "# Conexión a MongoDB\n",
        "# ==========================\n",
        "MONGO_URI = \"mongodb+srv://<username>:<password>@<cluster>/<database>"\n",
        "mongo_client = MongoClient(MONGO_URI)\n",
        "db = mongo_client['database']\n",
        "projects_collection = db['projects']\n",
        "\n",
        "def upload_and_process_video():\n",
        "    \"\"\"\n",
        "    Sube un archivo de video desde el equipo, extrae su audio WAV, \n",
        "    sube ambos a Google Drive y guarda la info en MongoDB.\n",
        "    \"\"\"\n",
        "    print(\"Selecciona el archivo de video para subir:\")\n",
        "    uploaded = files.upload()\n",
        "\n",
        "    if not uploaded:\n",
        "        print(\"No se seleccionó ningún archivo\")\n",
        "        return None\n",
        "\n",
        "    # Obtener el primer archivo subido\n",
        "    filename = list(uploaded.keys())[0]\n",
        "    print(f\"Archivo subido: {filename}\")\n",
        "\n",
        "    try:\n",
        "        # 1. Crear documento en MongoDB\n",
        "        project_doc = {\"original_filename\": filename}\n",
        "        result = projects_collection.insert_one(project_doc)\n",
        "        project_id = str(result.inserted_id)\n",
        "        print(f\"MongoDB project_id: {project_id}\")\n",
        "\n",
        "        # 2. Renombrar archivo con el project_id\n",
        "        file_extension = os.path.splitext(filename)[1]\n",
        "        new_filename = f\"{project_id}{file_extension}\"\n",
        "\n",
        "        # Crear directorio temporal si no existe\n",
        "        os.makedirs('temp', exist_ok=True)\n",
        "\n",
        "        # Mover archivo a directorio temporal con nuevo nombre\n",
        "        filepath = os.path.join('temp', new_filename)\n",
        "        shutil.move(filename, filepath)\n",
        "        print(f\"Archivo guardado como: {filepath}\")\n",
        "\n",
        "        # 3. Extraer audio del video usando ffmpeg\n",
        "        audio_path = os.path.join('temp', f\"{project_id}.wav\")\n",
        "        print(\"Extrayendo audio del video...\")\n",
        "        subprocess.run([\n",
        "            'ffmpeg', '-y', '-i', filepath,\n",
        "            '-vn', '-acodec', 'pcm_s16le',\n",
        "            '-ar', '44100', '-ac', '2',\n",
        "            audio_path\n",
        "        ], check=True)\n",
        "        print(f\"Audio extraído: {audio_path}\")\n",
        "\n",
        "        # 4. Configurar credenciales y servicio de Drive\n",
        "        creds = Credentials(\n",
        "            None,\n",
        "            refresh_token=REFRESH_TOKEN,\n",
        "            client_id=CLIENT_ID,\n",
        "            client_secret=CLIENT_SECRET,\n",
        "            token_uri='https://oauth2.googleapis.com/token'\n",
        "        )\n",
        "        service = build('drive', 'v3', credentials=creds)\n",
        "\n",
        "        # 5. Subir video a Google Drive\n",
        "        print(\"Subiendo video a Google Drive...\")\n",
        "        video_media = MediaFileUpload(filepath)\n",
        "        video_metadata = {\n",
        "            'name': new_filename,\n",
        "            'parents': ['195TbCi27MxDtzV9RATxQ2bBHwsSDUmzb']  # Carpeta de videos\n",
        "        }\n",
        "        video_upload = service.files().create(\n",
        "            body=video_metadata,\n",
        "            media_body=video_media,\n",
        "            fields='id,webContentLink'\n",
        "        ).execute()\n",
        "        print(f\"Video subido - ID: {video_upload.get('id')}\")\n",
        "\n",
        "        # 6. Subir audio a Google Drive\n",
        "        print(\"Subiendo audio a Google Drive...\")\n",
        "        audio_media = MediaFileUpload(audio_path)\n",
        "        audio_metadata = {\n",
        "            'name': f\"{project_id}.wav\",\n",
        "            'parents': ['1fjmlPFGe8QEXoPjcAZFMFd6AkErkFVCI']  # Carpeta de audios\n",
        "        }\n",
        "        audio_upload = service.files().create(\n",
        "            body=audio_metadata,\n",
        "            media_body=audio_media,\n",
        "            fields='id,webContentLink'\n",
        "        ).execute()\n",
        "        print(f\"Audio subido - ID: {audio_upload.get('id')}\")\n",
        "\n",
        "        # 7. Actualizar documento en MongoDB con ambos IDs y URLs\n",
        "        projects_collection.update_one(\n",
        "            {\"_id\": result.inserted_id},\n",
        "            {\"$set\": {\n",
        "                \"video_file_id\": video_upload.get('id'),\n",
        "                \"video_download_url\": video_upload.get('webContentLink'),\n",
        "                \"audio_file_id\": audio_upload.get('id'),\n",
        "                \"audio_download_url\": audio_upload.get('webContentLink')\n",
        "            }}\n",
        "        )\n",
        "        print(\"Base de datos actualizada\")\n",
        "\n",
        "        # 8. Limpiar archivos temporales\n",
        "        try:\n",
        "            if hasattr(video_media, '_fd') and not video_media._fd.closed:\n",
        "                video_media._fd.close()\n",
        "            if hasattr(audio_media, '_fd') and not audio_media._fd.closed:\n",
        "                audio_media._fd.close()\n",
        "            time.sleep(0.5)\n",
        "\n",
        "            if os.path.exists(filepath):\n",
        "                os.remove(filepath)\n",
        "            if os.path.exists(audio_path):\n",
        "                os.remove(audio_path)\n",
        "            print('Archivos temporales eliminados')\n",
        "        except Exception as cleanup_error:\n",
        "            print(f\"Error limpiando archivos: {cleanup_error}\")\n",
        "\n",
        "        # 9. Retornar información del proceso\n",
        "        result_info = {\n",
        "            'video_file_id': video_upload.get('id'),\n",
        "            'audio_file_id': audio_upload.get('id'),\n",
        "            'project_id': project_id,\n",
        "            'video_download_url': video_upload.get('webContentLink'),\n",
        "            'audio_download_url': audio_upload.get('webContentLink')\n",
        "        }\n",
        "\n",
        "        print(\"\\n=== PROCESO COMPLETADO ===\")\n",
        "        print(f\"Project ID: {project_id}\")\n",
        "        print(f\"Video ID: {video_upload.get('id')}\")\n",
        "        print(f\"Audio ID: {audio_upload.get('id')}\")\n",
        "        print(f\"Video URL: {video_upload.get('webContentLink')}\")\n",
        "        print(f\"Audio URL: {audio_upload.get('webContentLink')}\")\n",
        "\n",
        "        return result_info\n",
        "\n",
        "    except subprocess.CalledProcessError as ffmpeg_error:\n",
        "        print(f\"Error con ffmpeg: {ffmpeg_error}\")\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"Error general: {str(e)}\")\n",
        "\n",
        "        # Limpiar recursos en caso de error\n",
        "        try:\n",
        "            if 'video_media' in locals() and hasattr(video_media, '_fd') and not video_media._fd.closed:\n",
        "                video_media._fd.close()\n",
        "            if 'audio_media' in locals() and hasattr(audio_media, '_fd') and not audio_media._fd.closed:\n",
        "                audio_media._fd.close()\n",
        "            time.sleep(0.5)\n",
        "\n",
        "            if 'filepath' in locals() and os.path.exists(filepath):\n",
        "                os.remove(filepath)\n",
        "            if 'audio_path' in locals() and os.path.exists(audio_path):\n",
        "                os.remove(audio_path)\n",
        "        except Exception as cleanup_error:\n",
        "            print(f\"Error limpiando archivos tras error: {cleanup_error}\")\n",
        "\n",
        "        return None\n",
        "\n",
        "def check_project_status(project_id):\n",
        "    \"\"\"\n",
        "    Verifica el estado de un proyecto en la base de datos.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        from bson import ObjectId\n",
        "        project = projects_collection.find_one({\"_id\": ObjectId(project_id)})\n",
        "        if project:\n",
        "            print(f\"Proyecto encontrado: {project}\")\n",
        "            return project\n",
        "        else:\n",
        "            print(\"Proyecto no encontrado\")\n",
        "            return None\n",
        "    except Exception as e:\n",
        "        print(f\"Error consultando proyecto: {e}\")\n",
        "        return None\n",
        "\n",
        "print(\"=== PROCESADOR DE VIDEO Y AUDIO CARGADO ===\")\n",
        "print(\"Para ejecutar, llama a la función: upload_and_process_video()\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
